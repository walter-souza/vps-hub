{
  "name": "vps-hub",
  "version": "1.0.0",
  "description": "Hub de VPS com explorador de arquivos via SSH/SFTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/walter-souza/vps-hub.git"
  },
  "homepage": "https://github.com/walter-souza/vps-hub#readme",
  "bugs": {
    "url": "https://github.com/walter-souza/vps-hub/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "test:e2e": "electron-vite build && node --test --test-concurrency=1 --test-global-setup=tests/e2e/setup.mjs tests/e2e/core.test.mjs tests/e2e/archive.test.mjs tests/e2e/dnd.test.mjs tests/e2e/drop-files.test.mjs tests/e2e/import-trash.test.mjs tests/e2e/paste.test.mjs tests/e2e/perms.test.mjs tests/e2e/search.test.mjs tests/e2e/selection.test.mjs tests/e2e/transfers.test.mjs"
  },
  "type": "commonjs",
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.64.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "build": {
    "appId": "com.vpshub.app",
    "productName": "VPS Hub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "VPS Hub"
    }
  }
}
